# ─── ENVIRONMENT ───
NODE_ENV=development
PORT=3001

# ─── DATABASE ───
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ejua_marketplace
DB_USER=ejua_admin
DB_PASSWORD=your_secure_password_here
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# ─── REDIS ───
REDIS_URL=redis://localhost:6379

# ─── JWT ───
JWT_SECRET=change_this_to_a_64_char_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── PAYSTACK ───
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
PAYSTACK_API_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=http://localhost:3001/api/v1/payments/callback
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# ─── MOTITO BNPL ───
MOTITO_API_URL=https://sandbox.motito.co/v1
MOTITO_MERCHANT_ID=ejua_sandbox_001
MOTITO_API_KEY=your_motito_sandbox_key
MOTITO_WEBHOOK_SECRET=your_motito_webhook_secret

# ─── MOMO (MTN) ───
MOMO_API_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=your_mtn_sub_key
MOMO_API_USER=your_api_user_uuid
MOMO_API_KEY=your_api_key
MOMO_ENVIRONMENT=sandbox
MOMO_CURRENCY=GHS

# ─── CLOUDFLARE R2 STORAGE ───
R2_ENDPOINT=https://30eb54551b0d67c56918195b7a1fc21b.r2.cloudflarestorage.com
R2_BUCKET_NAME=nesisoft-s3-bucket
R2_PREFIX=ejua
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_PUBLIC_URL=https://pub-a0a8767766c84b1d804f6206f3d1d5d3.r2.dev

# ─── CREATIVE ENGINE ───
CREATIVE_ENGINE_URL=http://localhost:3002
REMOVEBG_API_KEY=your_removebg_key

# ─── AMPLIFY ENGINE ───
AMPLIFY_ENGINE_URL=http://localhost:3003
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# ─── API GATEWAY ───
GATEWAY_PORT=3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ─── PLATFORM ───
PLATFORM_NAME=Ejua
PLATFORM_URL=https://ejua.com
DEFAULT_CURRENCY=GHS
DEFAULT_COMMISSION_BPS=1000
DEFAULT_ESCROW_DAYS=14
DEFAULT_GRACE_PERIOD_DAYS=3
DEFAULT_LATE_FEE_BPS=200
DEFAULT_LATE_FEE_CAP_BPS=1500
