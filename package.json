{
  "name": "ejua-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Ejua Ejua — Composable Commerce Platform for Africa",
  "workspaces": [
    "packages/shared",
    "packages/marketplace-engine",
    "packages/creative-engine",
    "packages/amplify-engine",
    "apps/storefront",
    "gateway"
  ],
  "scripts": {
    "dev:marketplace": "npm run dev --workspace=packages/marketplace-engine",
    "dev:creative": "npm run dev --workspace=packages/creative-engine",
    "dev:amplify": "npm run dev --workspace=packages/amplify-engine",
    "dev:storefront": "npm run dev --workspace=apps/storefront",
    "dev:gateway": "npm run dev --workspace=gateway",
    "test": "npm run test --workspaces --if-present",
    "test:marketplace": "npm run test --workspace=packages/marketplace-engine",
    "migrate": "npm run migrate --workspace=packages/marketplace-engine",
    "migrate:rollback": "npm run migrate:rollback --workspace=packages/marketplace-engine",
    "seed": "npm run seed --workspace=packages/marketplace-engine",
    "lint": "eslint packages/ gateway/ --ext .js",
    "format": "prettier --write \"packages/**/*.js\" \"gateway/**/*.js\""
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "prettier": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
